digraph G {
 graph [rankdir=LR, nodesep=0.45, ranksep=1.1, fontname="Liberation Sans", pad=0.3];
 node [fontname="Liberation Sans"]; edge [fontname="Liberation Sans", fontsize=9, arrowhead=none, labeldistance=2.2];
Usuario [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Usuario</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">email</font></td></tr><tr><td align="left" balign="left"><font point-size="9">senha_hash</font></td></tr><tr><td align="left" balign="left"><font point-size="9">provider (email | google)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">google_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lgpd_accepted_at</font></td></tr><tr><td align="left" balign="left"><font point-size="9">first_access</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr></table>>];
Sessao [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Sessao</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">access_token</font></td></tr><tr><td align="left" balign="left"><font point-size="9">refresh_token</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expires_at</font></td></tr></table>>];
TokenResetSenha [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>TokenResetSenha</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">token (hash SHA-256)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expira_em</font></td></tr><tr><td align="left" balign="left"><font point-size="9">usado</font></td></tr></table>>];
PreferenciaNotificacao [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>PreferenciaNotificacao</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">antecedencia_minutos</font></td></tr><tr><td align="left" balign="left"><font point-size="9">notificacoes_ativas</font></td></tr><tr><td align="left" balign="left"><font point-size="9">alerta_chegada</font></td></tr><tr><td align="left" balign="left"><font point-size="9">alerta_cancelamento</font></td></tr></table>>];
RotaFavorita [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>RotaFavorita</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">numero_linha</font></td></tr><tr><td align="left" balign="left"><font point-size="9">label</font></td></tr><tr><td align="left" balign="left"><font point-size="9">origem_lat / origem_lng</font></td></tr><tr><td align="left" balign="left"><font point-size="9">destino_lat / destino_lng</font></td></tr></table>>];
Ocorrencia [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Ocorrencia</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">linha_numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">tipo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">descricao</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status (pendente | confirmada | expirada)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">contador_confirmacoes</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expira_em</font></td></tr></table>>];
ConfirmacaoOcorrencia [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>ConfirmacaoOcorrencia</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">ocorrencia_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">criado_em</font></td></tr></table>>];
Viagem [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Viagem</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">numero_linha</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">veiculo_prefixo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">parada_destino_codigo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">embarcou_em</font></td></tr><tr><td align="left" balign="left"><font point-size="9">encerrada_em</font></td></tr></table>>];
AlertaProximidade [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>AlertaProximidade</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">parada_destino_codigo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr><tr><td align="left" balign="left"><font point-size="9">eta_minutos</font></td></tr><tr><td align="left" balign="left"><font point-size="9">disparado_em</font></td></tr></table>>];
InscricaoPush [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>InscricaoPush</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">endpoint</font></td></tr><tr><td align="left" balign="left"><font point-size="9">p256dh</font></td></tr><tr><td align="left" balign="left"><font point-size="9">auth</font></td></tr><tr><td align="left" balign="left"><font point-size="9">ultima_falha_em</font></td></tr></table>>];
Linha [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Linha</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">trajeto (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">paradas (JSON)</font></td></tr></table>>];
Rota [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Rota</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">trajeto (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">horarios_por_dia</font></td></tr><tr><td align="left" balign="left"><font point-size="9">tempo_percurso_min</font></td></tr></table>>];
Parada [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF"><tr><td bgcolor="#D9E2F3"><b>Parada</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">codigo (estável)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lat / lng</font></td></tr></table>>];
PosicaoOnibus [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F2F2F2" style="dashed"><tr><td bgcolor="#D9E2F3"><b>&lt;&lt;não persistida&gt;&gt;<br/>PosicaoOnibus</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9">prefixo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">linha</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lat / lng</font></td></tr><tr><td align="left" balign="left"><font point-size="9">atualizado_em</font></td></tr></table>>];
 Usuario -> Sessao [taillabel="1", headlabel="0..*"];
 Usuario -> TokenResetSenha [taillabel="1", headlabel="0..*"];
 Usuario -> PreferenciaNotificacao [taillabel="1", headlabel="1"];
 Usuario -> RotaFavorita [taillabel="1", headlabel="0..20"];
 Usuario -> Ocorrencia [taillabel="1", headlabel="0..*"];
 Ocorrencia -> ConfirmacaoOcorrencia [taillabel="1", headlabel="0..*"];
 Usuario -> ConfirmacaoOcorrencia [taillabel="1", headlabel="0..*"];
 Usuario -> Viagem [taillabel="1", headlabel="0..1 ativa"];
 Viagem -> AlertaProximidade [taillabel="1", headlabel="0..*"];
 Usuario -> InscricaoPush [taillabel="1", headlabel="0..*"];
 Linha -> Rota [taillabel="1", headlabel="1..*"];
 Rota -> Parada [taillabel="*", headlabel="*", label="rota_parada"];
 Ocorrencia -> Linha [style=dashed, label="por número", fontcolor="#555555"];
 Viagem -> Linha [style=dashed, label="por número", fontcolor="#555555"];
 RotaFavorita -> Linha [style=dashed, label="por número", fontcolor="#555555"];
 PosicaoOnibus -> Linha [style=dashed, label="feed SEMOB", fontcolor="#555555"];
}
