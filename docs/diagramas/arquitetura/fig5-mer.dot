digraph G {
 graph [rankdir=LR, nodesep=0.35, ranksep=1.2, fontname="Liberation Sans", pad=0.3];
 node [fontname="Liberation Sans"]; edge [fontname="Liberation Sans", fontsize=9, arrowhead=crow, arrowtail=tee, dir=both];
 usuarios [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E8F1FB"><b>usuarios</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">email</font></td></tr><tr><td align="left" balign="left"><font point-size="9">senha_hash</font></td></tr><tr><td align="left" balign="left"><font point-size="9">avatar_url</font></td></tr><tr><td align="left" balign="left"><font point-size="9">provider</font></td></tr><tr><td align="left" balign="left"><font point-size="9">google_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lgpd_accepted_at</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr><tr><td align="left" balign="left"><font point-size="9">tentativas_falhas</font></td></tr><tr><td align="left" balign="left"><font point-size="9">bloqueado_ate</font></td></tr><tr><td align="left" balign="left"><font point-size="9">account_linking_pending</font></td></tr><tr><td align="left" balign="left"><font point-size="9">first_access</font></td></tr><tr><td align="left" balign="left"><font point-size="9">created_at</font></td></tr></table>>];
 sessoes [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E8F1FB"><b>sessoes</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9"><b>usuario_id FK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">access_token</font></td></tr><tr><td align="left" balign="left"><font point-size="9">refresh_token</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expires_at</font></td></tr></table>>];
 tokens_reset_senha [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E8F1FB"><b>tokens_reset_senha</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9"><b>usuario_id FK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">token</font></td></tr><tr><td align="left" balign="left"><font point-size="9">usado</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expira_em</font></td></tr></table>>];
 preferencias_notificacao [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E6F4E6"><b>preferencias_notificacao</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">antecedencia_minutos</font></td></tr><tr><td align="left" balign="left"><font point-size="9">notificacoes_ativas</font></td></tr><tr><td align="left" balign="left"><font point-size="9">alerta_chegada</font></td></tr><tr><td align="left" balign="left"><font point-size="9">alerta_cancelamento</font></td></tr></table>>];
 rotas_favoritas [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E6F4E6"><b>rotas_favoritas</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">numero_linha</font></td></tr><tr><td align="left" balign="left"><font point-size="9">label</font></td></tr><tr><td align="left" balign="left"><font point-size="9">origem_lat</font></td></tr><tr><td align="left" balign="left"><font point-size="9">origem_lng</font></td></tr><tr><td align="left" balign="left"><font point-size="9">destino_lat</font></td></tr><tr><td align="left" balign="left"><font point-size="9">destino_lng</font></td></tr></table>>];
 ocorrencia [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E6F4E6"><b>ocorrencia</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">linha_numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">tipo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">descricao</font></td></tr><tr><td align="left" balign="left"><font point-size="9">local</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lat</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lng</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr><tr><td align="left" balign="left"><font point-size="9">contador_confirmacoes</font></td></tr><tr><td align="left" balign="left"><font point-size="9">expira_em</font></td></tr></table>>];
 confirmacoes_ocorrencia [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#E6F4E6"><b>confirmacoes_ocorrencia</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9"><b>ocorrencia_id FK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">UNIQUE (ocorrencia_id, usuario_id)</font></td></tr></table>>];
 viagem [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>viagem</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">numero_linha</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">veiculo_prefixo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">parada_destino_codigo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">embarcou_em</font></td></tr><tr><td align="left" balign="left"><font point-size="9">encerrada_em</font></td></tr><tr><td align="left" balign="left"><font point-size="9">motivo_encerramento</font></td></tr><tr><td align="left" balign="left"><font point-size="9">origem_embarque</font></td></tr></table>>];
 alertas_proximidade [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>alertas_proximidade</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">viagem_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">linha_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">parada_destino_codigo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr><tr><td align="left" balign="left"><font point-size="9">eta_minutos</font></td></tr><tr><td align="left" balign="left"><font point-size="9">disparado_em</font></td></tr></table>>];
 inscricao_push [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>inscricao_push</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">endpoint</font></td></tr><tr><td align="left" balign="left"><font point-size="9">p256dh</font></td></tr><tr><td align="left" balign="left"><font point-size="9">auth</font></td></tr><tr><td align="left" balign="left"><font point-size="9">ultima_falha_em</font></td></tr></table>>];
 linha [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>linha</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">paradas (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">trajeto (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">horarios_previstos</font></td></tr></table>>];
 rota [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>rota</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">trajeto (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">paradas (JSON)</font></td></tr><tr><td align="left" balign="left"><font point-size="9">horarios_por_dia</font></td></tr><tr><td align="left" balign="left"><font point-size="9">tempo_percurso_min</font></td></tr></table>>];
 rota_parada [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>rota_parada</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">numero</font></td></tr><tr><td align="left" balign="left"><font point-size="9">sentido</font></td></tr><tr><td align="left" balign="left"><font point-size="9"><b>parada_id FK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">ordem</font></td></tr><tr><td align="left" balign="left"><font point-size="9">indice_trajeto</font></td></tr><tr><td align="left" balign="left"><font point-size="9">distancia_acumulada_m</font></td></tr><tr><td align="left" balign="left"><font point-size="9">distancia_ao_trajeto_m</font></td></tr></table>>];
 parada [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>parada</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">codigo</font></td></tr><tr><td align="left" balign="left"><font point-size="9">nome</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lat</font></td></tr><tr><td align="left" balign="left"><font point-size="9">lng</font></td></tr></table>>];
 alertas [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>alertas</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">linha_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">status</font></td></tr><tr><td align="left" balign="left"><font point-size="9">atraso_inicio_minutos</font></td></tr><tr><td align="left" balign="left"><font point-size="9">cancelado_em</font></td></tr></table>>];
 linhas_acompanhadas [shape=plain label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="white"><tr><td bgcolor="#FFF4D6"><b>linhas_acompanhadas</b></td></tr><hr/><tr><td align="left" balign="left"><font point-size="9"><b>id PK</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">usuario_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">linha_id</font></td></tr><tr><td align="left" balign="left"><font point-size="9">ativo</font></td></tr></table>>];
 usuarios -> sessoes;
 usuarios -> tokens_reset_senha;
 ocorrencia -> confirmacoes_ocorrencia;
 parada -> rota_parada;
 usuarios -> preferencias_notificacao [style=dashed, label="FK só na migration"];
 usuarios -> rotas_favoritas [style=dashed, label="FK só na migration"];
 usuarios -> ocorrencia [style=dotted, color="#777777"];
 usuarios -> viagem [style=dotted, color="#777777"];
 viagem -> alertas_proximidade [style=dotted, color="#777777"];
 usuarios -> inscricao_push [style=dotted, color="#777777"];
 usuarios -> confirmacoes_ocorrencia [style=dotted, color="#777777"];
 linha -> rota [style=dotted, color="#777777", label="por número"];
 rota -> rota_parada [style=dotted, color="#777777", label="por número e sentido"];
 ocorrencia -> linha [style=dotted, color="#777777", label="linha_numero"];
 subgraph cluster_leg { label="Legenda"; style=dashed; fontsize=9; leg [shape=plain label=<<table border="0" cellspacing="0"><tr><td align="left"><font point-size="9">linha contínua: chave estrangeira no banco</font></td></tr><tr><td align="left"><font point-size="9">tracejada: chave criada só na migration</font></td></tr><tr><td align="left"><font point-size="9">pontilhada: referência lógica, sem chave estrangeira</font></td></tr><tr><td align="left"><font point-size="9">cor do título: serviço dono (azul auth, verde colaboração, amarelo mobilidade)</font></td></tr></table>>]; }
}
