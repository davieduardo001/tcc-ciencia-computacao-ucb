        <bpmn:flowNodeRef>cd_gm_E09</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="cd_dfp_E08" name="Consulta recebida">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="cd_dfp_A15" name="Consultar posição de GPS oficial da linha"/>
