<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ASIS" targetNamespace="http://movecity.ucb.br/bpmn">
  <bpmn:collaboration id="Collab_ASIS">
    <bpmn:participant id="Part_Passageiro" name="Passageiro" processRef="Process_Passageiro"/>
    <bpmn:participant id="Part_CanaisDigitais" name="Canais Digitais de Informação" processRef="Process_CanaisDigitais"/>
    <bpmn:participant id="Part_RedeInformal" name="Rede Informal de Passageiros / Redes Sociais"/>
    <bpmn:participant id="Part_Operadora" name="Empresa Operadora" processRef="Process_Operadora"/>
    <bpmn:participant id="Part_Ouvidoria" name="Ouvidoria do GDF" processRef="Process_Ouvidoria"/>
    <bpmn:messageFlow id="Mflow_0" sourceRef="p1_A02" targetRef="cd_dfp_E08" name="Consulta enviada ao DF no Ponto"/>
    <bpmn:messageFlow id="Mflow_1" sourceRef="cd_dfp_E09" targetRef="p1_E14" name="Resposta do DF no Ponto"/>
    <bpmn:messageFlow id="Mflow_2" sourceRef="p1_A02" targetRef="cd_gm_E08" name="Consulta enviada ao Google Maps/Moovit"/>
    <bpmn:messageFlow id="Mflow_3" sourceRef="cd_gm_E09" targetRef="p1_E14" name="Resposta do Google Maps/Moovit"/>
    <bpmn:messageFlow id="Mflow_4" sourceRef="p1_A08" targetRef="cd_dfp_E08" name="Nova consulta durante a espera"/>
    <bpmn:messageFlow id="Mflow_5" sourceRef="cd_dfp_E09" targetRef="p1_E16" name="Nova resposta durante a espera"/>
    <bpmn:messageFlow id="Mflow_6" sourceRef="p1_A03" targetRef="Part_RedeInformal" name="Pergunta sobre a linha"/>
    <bpmn:messageFlow id="Mflow_7" sourceRef="Part_RedeInformal" targetRef="p1_E15" name="Resposta de outro passageiro"/>
    <bpmn:messageFlow id="Mflow_8" sourceRef="Part_RedeInformal" targetRef="p1_E16" name="Informação informal durante a espera"/>
    <bpmn:messageFlow id="Mflow_9" sourceRef="op_E13" targetRef="p1_A07" name="Chegada do veículo à parada"/>
    <bpmn:messageFlow id="Mflow_10" sourceRef="p4_A04" targetRef="ouv_E08" name="Manifestação do cidadão"/>
    <bpmn:messageFlow id="Mflow_11" sourceRef="p4_A05" targetRef="Part_RedeInformal" name="Publicação sobre a ocorrência"/>
    <bpmn:messageFlow id="Mflow_12" sourceRef="p4_A06" targetRef="op_E10b" name="Chamado registrado no SAC"/>
    <bpmn:messageFlow id="Mflow_13" sourceRef="ouv_A10" targetRef="op_E10b" name="Solicitação de apuração"/>
    <bpmn:messageFlow id="Mflow_14" sourceRef="op_A17b" targetRef="ouv_A11" name="Retorno da apuração"/>
    <bpmn:messageFlow id="Mflow_15" sourceRef="ouv_A13" targetRef="p4_E03" name="Resposta oficial ao cidadão"/>
    <bpmn:messageFlow id="Mflow_16" sourceRef="op_A17b" targetRef="p4_E03" name="Resposta do SAC"/>
    <bpmn:messageFlow id="Mflow_17" sourceRef="Part_RedeInformal" targetRef="p4_E03" name="Comentários não verificados"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Passageiro" isExecutable="false">
    <bpmn:startEvent id="p1_E01" name="Necessidade de deslocamento identificada"/>
    <bpmn:userTask id="p1_A01" name="Definir origem, destino e horário desejado"/>
    <bpmn:userTask id="p1_A02" name="Consultar canais digitais"/>
    <bpmn:intermediateCatchEvent id="p1_E14" name="Receber resposta dos canais digitais">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="p1_G01" name="Informação suficiente e confiável?"/>
    <bpmn:manualTask id="p1_A03" name="Perguntar em grupo / rede social"/>
    <bpmn:intermediateCatchEvent id="p1_E15" name="Receber resposta da rede informal">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="p1_A04" name="Estimar horário pela experiência própria"/>
    <bpmn:exclusiveGateway id="p1_G02" name="Junção"/>
    <bpmn:userTask id="p1_A05" name="Escolher linha e horário, com margem de segurança"/>
    <bpmn:manualTask id="p1_A06" name="Deslocar-se até a parada"/>
    <bpmn:receiveTask id="p1_A07" name="Aguardar chegada do ônibus"/>
    <bpmn:boundaryEvent id="p1_E02" name="Espera excede ~15min" attachedToRef="p1_A07" cancelActivity="true">
      <bpmn:timerEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="p1_E03" name="Percepção de risco/insegurança" attachedToRef="p1_A07" cancelActivity="true">
      <bpmn:conditionalEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="p1_A08" name="Reconsultar app e checar com outros na parada"/>
    <bpmn:intermediateCatchEvent id="p1_E16" name="Receber resposta durante a espera">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="p1_G03" name="Confirmação de que o ônibus virá?"/>
    <bpmn:exclusiveGateway id="p1_G04" name="Qual alternativa adotar?"/>
    <bpmn:manualTask id="p1_A09" name="Contratar transporte por app/táxi"/>
    <bpmn:manualTask id="p1_A10" name="Tentar outra linha/itinerário"/>
    <bpmn:userTask id="p1_A11" name="Avisar sobre atraso/ausência"/>
    <bpmn:manualTask id="p1_A12" name="Deixar a parada, procurar local seguro"/>
    <bpmn:exclusiveGateway id="p1_G05" name="Veículo atende (linha certa, com espaço)?"/>
    <bpmn:manualTask id="p1_A13" name="Embarcar e validar passagem"/>
    <bpmn:manualTask id="p1_A14" name="Realizar a viagem"/>
    <bpmn:endEvent id="p1_E04" name="Concluído no tempo previsto"/>
    <bpmn:endEvent id="p1_E05" name="Concluído com atraso e custo adicional"/>
    <bpmn:endEvent id="p1_E06" name="Não realizado - compromisso perdido"/>
    <bpmn:endEvent id="p1_E07" name="Espera abandonada por insegurança"/>
    <bpmn:startEvent id="p4_E01" name="Ocorrência vivenciada durante o deslocamento"/>
    <bpmn:userTask id="p4_A01" name="Identificar tipo de ocorrência"/>
    <bpmn:manualTask id="p4_A02" name="Reunir dados (linha, horário, local, evidências)"/>
    <bpmn:exclusiveGateway id="p4_G01" name="Esforço de registrar compensa?"/>
    <bpmn:manualTask id="p4_A03" name="Relatar informalmente, não registrar"/>
    <bpmn:endEvent id="p4_E02" name="Ocorrência não registrada"/>
    <bpmn:inclusiveGateway id="p4_G02" name="Quais canais acionar?"/>
    <bpmn:userTask id="p4_A04" name="Registrar na ouvidoria"/>
    <bpmn:userTask id="p4_A05" name="Publicar em rede social/grupo"/>
    <bpmn:userTask id="p4_A06" name="Acionar SAC da operadora"/>
    <bpmn:inclusiveGateway id="p4_G03" name="Junção"/>
    <bpmn:eventBasedGateway id="p4_G04" name="Aguardar retorno"/>
    <bpmn:intermediateCatchEvent id="p4_E03" name="Resposta recebida">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="p4_E04" name="Prazo esgotado sem retorno">
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="p4_E05" name="Sem retorno - canal inefetivo"/>
    <bpmn:userTask id="p4_A07" name="Analisar resposta recebida"/>
    <bpmn:exclusiveGateway id="p4_G05" name="Resolve ou explica o problema?"/>
    <bpmn:endEvent id="p4_E06" name="Encerrada com resposta satisfatória"/>
    <bpmn:endEvent id="p4_E07" name="Resposta sem solução efetiva"/>
