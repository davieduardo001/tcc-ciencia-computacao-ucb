      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:startEvent id="cd_gm_E08" name="Consulta recebida">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="cd_gm_A15" name="Consultar apenas horário programado (sem GPS oficial)"/>
