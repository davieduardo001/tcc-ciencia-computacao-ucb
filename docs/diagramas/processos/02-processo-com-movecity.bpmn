<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MOVECITY" targetNamespace="http://movecity.ucb.br/bpmn">
  <bpmn:collaboration id="Collab_MOVECITY">
    <bpmn:participant id="Part_Passageiro" name="Passageiro" processRef="Process_Passageiro"/>
    <bpmn:participant id="Part_Movecity" name="Movecity" processRef="Process_Movecity"/>
    <bpmn:participant id="Part_Operadora" name="Empresa Operadora" processRef="Process_Operadora"/>
    <bpmn:participant id="Part_Ouvidoria" name="Ouvidoria do GDF (canal formal, inalterado)" processRef="Process_Ouvidoria"/>
    <bpmn:messageFlow id="Mflow_0" sourceRef="p1_A02" targetRef="mv_E08" name="Consulta enviada ao Movecity"/>
    <bpmn:messageFlow id="Mflow_1" sourceRef="mv_E09" targetRef="p1_E14" name="Resposta do Movecity: posição real"/>
    <bpmn:messageFlow id="Mflow_3" sourceRef="p1_A08b" targetRef="mv_E08" name="Nova consulta durante a espera"/>
    <bpmn:messageFlow id="Mflow_2" sourceRef="mv_E09" targetRef="p1_E16" name="Resposta atualizada (ETA e ocorrências)"/>
    <bpmn:messageFlow id="Mflow_4" sourceRef="op_E13" targetRef="p1_A07" name="Chegada do veículo à parada"/>
    <bpmn:messageFlow id="Mflow_5" sourceRef="p4_A01" targetRef="mv_E20" name="Reporte estruturado enviado"/>
    <bpmn:messageFlow id="Mflow_7" sourceRef="p4_A04" targetRef="ouv_E08" name="Manifestação do cidadão (registro formal)"/>
    <bpmn:messageFlow id="Mflow_8" sourceRef="p4_A06" targetRef="op_E10b" name="Chamado registrado no SAC (mantido)"/>
    <bpmn:messageFlow id="Mflow_9" sourceRef="ouv_A10" targetRef="op_E10b" name="Solicitação de apuração (mantida)"/>
    <bpmn:messageFlow id="Mflow_10" sourceRef="op_A17b" targetRef="ouv_A11" name="Retorno da apuração (mantido)"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Passageiro" isExecutable="false">
    <bpmn:startEvent id="p1_E01" name="Necessidade de deslocamento identificada"/>
    <bpmn:userTask id="p1_A01" name="Definir origem, destino e horário desejado"/>
    <bpmn:userTask id="p1_A02" name="Consultar o Movecity"/>
    <bpmn:intermediateCatchEvent id="p1_E14" name="Receber resposta do Movecity (ao vivo, previsto ou sem previsão)">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="p1_A05" name="Escolher linha e horário de saída"/>
    <bpmn:manualTask id="p1_A06" name="Deslocar-se até a parada"/>
    <bpmn:receiveTask id="p1_A07" name="Aguardar chegada do ônibus (acompanhando o ETA no Movecity)"/>
    <bpmn:boundaryEvent id="p1_E18" name="Espera acima da margem prevista" attachedToRef="p1_A07" cancelActivity="true">
      <bpmn:timerEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="p1_A08b" name="Reconsultar ETA e ocorrências no Movecity"/>
    <bpmn:boundaryEvent id="p1_E03" name="Percepção de risco/insegurança" attachedToRef="p1_A07" cancelActivity="true">
      <bpmn:conditionalEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="p1_E16" name="Receber resposta atualizada do Movecity">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="p1_G04" name="Qual alternativa adotar?"/>
    <bpmn:manualTask id="p1_A09" name="Contratar transporte por app/táxi"/>
    <bpmn:manualTask id="p1_A10" name="Tentar outra linha ou rota (opções do planejador do Movecity)"/>
    <bpmn:userTask id="p1_A11" name="Avisar sobre atraso/ausência"/>
    <bpmn:manualTask id="p1_A12" name="Deixar a parada, procurar local seguro"/>
    <bpmn:exclusiveGateway id="p1_G05" name="Veículo atende (linha certa, com espaço)?"/>
    <bpmn:manualTask id="p1_A13" name="Embarcar, validar a passagem e tocar em 'Peguei este ônibus'"/>
    <bpmn:manualTask id="p1_A14" name="Realizar a viagem (faixa Em viagem e aviso de proximidade da parada de destino)"/>
    <bpmn:endEvent id="p1_E04" name="Concluído no tempo previsto (ETA com a fonte rotulada)"/>
    <bpmn:endEvent id="p1_E05" name="Concluído com transporte alternativo (decisão com dado mais atual)"/>
    <bpmn:endEvent id="p1_E06" name="Não realizado (desistência decidida com o dado do Movecity)"/>
    <bpmn:endEvent id="p1_E07" name="Espera abandonada por insegurança"/>
    <bpmn:startEvent id="p4_E01" name="Ocorrência vivenciada durante o deslocamento"/>
    <bpmn:userTask id="p4_A01" name="Abrir Reportar no Movecity (linha, tipo e local; localização por botão, opcional)"/>
    <bpmn:inclusiveGateway id="p4_G02" name="Também acionar canal formal?"/>
    <bpmn:userTask id="p4_A04" name="Registrar na ouvidoria (accountability legal)"/>
    <bpmn:userTask id="p4_A06" name="Acionar SAC da operadora"/>
    <bpmn:inclusiveGateway id="p4_G03" name="Junção"/>
    <bpmn:endEvent id="p4_E10" name="Reporte enviado ao Movecity"/>
    <bpmn:sequenceFlow id="Fpax_0" sourceRef="p1_E01" targetRef="p1_A01"/>
    <bpmn:sequenceFlow id="Fpax_1" sourceRef="p1_A01" targetRef="p1_A02"/>
    <bpmn:sequenceFlow id="Fpax_2" sourceRef="p1_A02" targetRef="p1_E14"/>
    <bpmn:sequenceFlow id="Fpax_3" sourceRef="p1_E14" targetRef="p1_A05"/>
    <bpmn:sequenceFlow id="Fpax_4" sourceRef="p1_A05" targetRef="p1_A06"/>
    <bpmn:sequenceFlow id="Fpax_5" sourceRef="p1_A06" targetRef="p1_A07"/>
    <bpmn:sequenceFlow id="Fpax_6" sourceRef="p1_A07" targetRef="p1_G05" name="Ônibus chegou"/>
    <bpmn:sequenceFlow id="Fpax_7" sourceRef="p1_E18" targetRef="p1_A08b" name="Espera excedida"/>
    <bpmn:sequenceFlow id="Fpax_8a" sourceRef="p1_A08b" targetRef="p1_E16"/>
    <bpmn:sequenceFlow id="Fpax_8b" sourceRef="p1_E16" targetRef="p1_G04"/>
    <bpmn:sequenceFlow id="Fpax_9" sourceRef="p1_G04" targetRef="p1_A09" name="Transporte alternativo"/>
    <bpmn:sequenceFlow id="Fpax_10" sourceRef="p1_G04" targetRef="p1_A10" name="Outra linha"/>
    <bpmn:sequenceFlow id="Fpax_11" sourceRef="p1_G04" targetRef="p1_A11" name="Desistir"/>
    <bpmn:sequenceFlow id="Fpax_12" sourceRef="p1_A09" targetRef="p1_E05"/>
    <bpmn:sequenceFlow id="Fpax_13" sourceRef="p1_A10" targetRef="p1_A05" name="Replaneja"/>
    <bpmn:sequenceFlow id="Fpax_14" sourceRef="p1_A11" targetRef="p1_E06"/>
    <bpmn:sequenceFlow id="Fpax_15" sourceRef="p1_E03" targetRef="p1_A12" name="Risco percebido"/>
    <bpmn:sequenceFlow id="Fpax_16" sourceRef="p1_A12" targetRef="p1_E07"/>
    <bpmn:sequenceFlow id="Fpax_17" sourceRef="p1_G05" targetRef="p1_A13" name="Sim"/>
    <bpmn:sequenceFlow id="Fpax_18" sourceRef="p1_G05" targetRef="p1_A07" name="Não - retorna a esperar"/>
    <bpmn:sequenceFlow id="Fpax_19" sourceRef="p1_A13" targetRef="p1_A14"/>
    <bpmn:sequenceFlow id="Fpax_20" sourceRef="p1_A14" targetRef="p1_E04"/>
    <bpmn:sequenceFlow id="Fpax_21" sourceRef="p4_E01" targetRef="p4_A01"/>
    <bpmn:sequenceFlow id="Fpax_22" sourceRef="p4_A01" targetRef="p4_G02"/>
    <bpmn:sequenceFlow id="Fpax_23" sourceRef="p4_G02" targetRef="p4_A04" name="Sim - também ouvidoria"/>
    <bpmn:sequenceFlow id="Fpax_24" sourceRef="p4_G02" targetRef="p4_A06" name="Sim - também SAC"/>
    <bpmn:sequenceFlow id="Fpax_25" sourceRef="p4_A04" targetRef="p4_G03"/>
    <bpmn:sequenceFlow id="Fpax_26" sourceRef="p4_A06" targetRef="p4_G03"/>
    <bpmn:sequenceFlow id="Fpax_27" sourceRef="p4_G02" targetRef="p4_E10" name="Não - só Movecity"/>
    <bpmn:sequenceFlow id="Fpax_28" sourceRef="p4_G03" targetRef="p4_E10"/>
  </bpmn:process>
  <bpmn:process id="Process_Movecity" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Movecity">
      <bpmn:lane id="Lane_Movecity_App" name="App">
        <bpmn:flowNodeRef>mv_E00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_E08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_E09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Movecity_Backend__Gateway___Serviços_" name="Backend (Gateway + Serviços)">
        <bpmn:flowNodeRef>mv_G_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A_aovivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A_previsto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_E20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_G10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_A28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_E21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv_E19</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="mv_E00" name="Passageiro abre o app">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="mv_A00" name="Capturar localização atual do usuário (GPS do celular)"/>
    <bpmn:startEvent id="mv_E08" name="Consulta de linha recebida">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="mv_A15" name="Calcular o ETA, rotular a fonte (ao vivo, previsto ou sem previsão) e exibir no mapa"/>
    <bpmn:endEvent id="mv_E09" name="Resposta enviada (com o selo da fonte)">
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="mv_G_pos" name="Há ônibus da linha com posição recente no feed da SEMOB?"/>
    <bpmn:serviceTask id="mv_A_aovivo" name="Calcular o ETA pela posição ao vivo (cache de 20 s, não persistida): selo ao vivo"/>
    <bpmn:serviceTask id="mv_A_previsto" name="Usar a saída prevista do terminal (snapshot da SEMOB no banco) ou informar sem previsão no momento"/>
    <bpmn:startEvent id="mv_E20" name="Reporte de ocorrência recebido">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="mv_A27" name="Registrar a ocorrência (até 3 por hora por usuário) e listá-la para a linha"/>
    <bpmn:exclusiveGateway id="mv_G10" name="Outros passageiros confirmaram (3 confirmações)?"/>
    <bpmn:serviceTask id="mv_A28" name="Marcar a ocorrência como Confirmada"/>
    <bpmn:endEvent id="mv_E21" name="Segue Aguardando confirmação até expirar (15 a 120 min conforme o tipo)"/>
    <bpmn:endEvent id="mv_E19" name="Ocorrência confirmada, visível na lista da linha até expirar (sem push)"/>
    <bpmn:sequenceFlow id="Fmv_0" sourceRef="mv_E00" targetRef="mv_A00"/>
    <bpmn:sequenceFlow id="Fmv_1" sourceRef="mv_A00" targetRef="mv_A15"/>
    <bpmn:sequenceFlow id="Fmv_2" sourceRef="mv_G_pos" targetRef="mv_A_aovivo" name="Sim"/>
    <bpmn:sequenceFlow id="Fmv_3" sourceRef="mv_G_pos" targetRef="mv_A_previsto" name="Não"/>
    <bpmn:sequenceFlow id="Fmv_4" sourceRef="mv_A_aovivo" targetRef="mv_A15"/>
    <bpmn:sequenceFlow id="Fmv_5" sourceRef="mv_A_previsto" targetRef="mv_A15"/>
    <bpmn:sequenceFlow id="Fmv_6" sourceRef="mv_E08" targetRef="mv_G_pos"/>
    <bpmn:sequenceFlow id="Fmv_7" sourceRef="mv_A15" targetRef="mv_E09"/>
    <bpmn:sequenceFlow id="Fmv_9" sourceRef="mv_E20" targetRef="mv_A27"/>
    <bpmn:sequenceFlow id="Fmv_10" sourceRef="mv_A27" targetRef="mv_G10"/>
    <bpmn:sequenceFlow id="Fmv_11" sourceRef="mv_G10" targetRef="mv_A28" name="Sim"/>
    <bpmn:sequenceFlow id="Fmv_12" sourceRef="mv_G10" targetRef="mv_E21" name="Não - ainda"/>
    <bpmn:sequenceFlow id="Fmv_13" sourceRef="mv_A28" targetRef="mv_E19"/>
  </bpmn:process>
  <bpmn:process id="Process_Operadora" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Operadora">
      <bpmn:lane id="Lane_Operadora_CCO" name="CCO">
        <bpmn:flowNodeRef>op_E10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_A19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_G08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_A20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_E11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_A21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_E12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operadora_Motorista" name="Motorista">
        <bpmn:flowNodeRef>op_A22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_E13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_A23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_G09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operadora_SAC" name="SAC">
        <bpmn:flowNodeRef>op_E10b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_A17b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_E11b</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="op_E10" name="Início da programação diária">
      <bpmn:timerEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="op_A19" name="Escalar veículos e motoristas"/>
    <bpmn:exclusiveGateway id="op_G08" name="Há recursos disponíveis?"/>
    <bpmn:userTask id="op_A20" name="Cancelar ou remanejar a viagem"/>
    <bpmn:endEvent id="op_E11" name="Viagem não realizada (sem aviso ao passageiro: a lacuna D1 permanece)"/>
    <bpmn:textAnnotation id="op_N01">
      <bpmn:text>Sem integração com a operadora: o cancelamento não chega ao Movecity (US #28 não entregue)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="op_Assoc01" sourceRef="op_N01" targetRef="op_E11"/>
    <bpmn:userTask id="op_A21" name="Registrar viagem, encerrar operação do dia"/>
    <bpmn:endEvent id="op_E12" name="Viagem concluída"/>
    <bpmn:manualTask id="op_A22" name="Executar itinerário da linha"/>
    <bpmn:intermediateThrowEvent id="op_E13" name="Chegada à parada">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="op_A23" name="Realizar embarque/desembarque"/>
    <bpmn:exclusiveGateway id="op_G09" name="Fim do itinerário?"/>
    <bpmn:startEvent id="op_E10b" name="Demanda recebida (SAC ou ouvidoria) - canal formal mantido">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="op_A17b" name="Apurar e responder ao solicitante"/>
    <bpmn:endEvent id="op_E11b" name="Demanda encerrada"/>
    <bpmn:sequenceFlow id="Fop_0" sourceRef="op_E10" targetRef="op_A19"/>
    <bpmn:sequenceFlow id="Fop_1" sourceRef="op_A19" targetRef="op_G08"/>
    <bpmn:sequenceFlow id="Fop_2" sourceRef="op_G08" targetRef="op_A22" name="Sim"/>
    <bpmn:sequenceFlow id="Fop_4" sourceRef="op_A20" targetRef="op_E11"/>
    <bpmn:sequenceFlow id="Fop_3" sourceRef="op_G08" targetRef="op_A20" name="Não"/>
    <bpmn:sequenceFlow id="Fop_6" sourceRef="op_A22" targetRef="op_E13"/>
    <bpmn:sequenceFlow id="Fop_7" sourceRef="op_E13" targetRef="op_A23"/>
    <bpmn:sequenceFlow id="Fop_8" sourceRef="op_A23" targetRef="op_G09"/>
    <bpmn:sequenceFlow id="Fop_9" sourceRef="op_G09" targetRef="op_A22" name="Não - próxima parada"/>
    <bpmn:sequenceFlow id="Fop_10" sourceRef="op_G09" targetRef="op_A21" name="Sim - concluído"/>
    <bpmn:sequenceFlow id="Fop_11" sourceRef="op_A21" targetRef="op_E12"/>
    <bpmn:sequenceFlow id="Fop_12" sourceRef="op_E10b" targetRef="op_A17b"/>
    <bpmn:sequenceFlow id="Fop_13" sourceRef="op_A17b" targetRef="op_E11b"/>
  </bpmn:process>
  <bpmn:process id="Process_Ouvidoria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Ouvidoria">
      <bpmn:lane id="Lane_Ouvidoria_Atendimento" name="Atendimento">
        <bpmn:flowNodeRef>ouv_E08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_E09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ouvidoria_Área_técnica" name="Área técnica">
        <bpmn:flowNodeRef>ouv_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouv_A12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ouv_E08" name="Manifestação recebida">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="ouv_A08" name="Registrar e classificar"/>
    <bpmn:userTask id="ouv_A09" name="Encaminhar à área responsável"/>
    <bpmn:userTask id="ouv_A13" name="Consolidar e enviar resposta ao cidadão"/>
    <bpmn:endEvent id="ouv_E09" name="Manifestação respondida e arquivada (até 30 dias)"/>
    <bpmn:userTask id="ouv_A10" name="Solicitar apuração à operadora"/>
    <bpmn:receiveTask id="ouv_A11" name="Aguardar retorno da apuração"/>
    <bpmn:userTask id="ouv_A12" name="Elaborar resposta técnica"/>
    <bpmn:sequenceFlow id="Fouv_0" sourceRef="ouv_E08" targetRef="ouv_A08"/>
    <bpmn:sequenceFlow id="Fouv_1" sourceRef="ouv_A08" targetRef="ouv_A09"/>
    <bpmn:sequenceFlow id="Fouv_2" sourceRef="ouv_A09" targetRef="ouv_A10"/>
    <bpmn:sequenceFlow id="Fouv_3" sourceRef="ouv_A10" targetRef="ouv_A11"/>
    <bpmn:sequenceFlow id="Fouv_4" sourceRef="ouv_A11" targetRef="ouv_A12"/>
    <bpmn:sequenceFlow id="Fouv_5" sourceRef="ouv_A12" targetRef="ouv_A13"/>
    <bpmn:sequenceFlow id="Fouv_6" sourceRef="ouv_A13" targetRef="ouv_E09"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_MOVECITY">
    <bpmndi:BPMNPlane id="Plane_MOVECITY" bpmnElement="Collab_MOVECITY">
      <bpmndi:BPMNShape id="Shape_Part_Passageiro" bpmnElement="Part_Passageiro" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="6070" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_E01" bpmnElement="p1_E01">
        <dc:Bounds x="130" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A01" bpmnElement="p1_A01">
        <dc:Bounds x="350" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A02" bpmnElement="p1_A02">
        <dc:Bounds x="570" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_E14" bpmnElement="p1_E14">
        <dc:Bounds x="790" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A05" bpmnElement="p1_A05">
        <dc:Bounds x="1010" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A06" bpmnElement="p1_A06">
        <dc:Bounds x="1230" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A07" bpmnElement="p1_A07">
        <dc:Bounds x="1450" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_E18" bpmnElement="p1_E18">
        <dc:Bounds x="1465" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_A08b" bpmnElement="p1_A08b">
        <dc:Bounds x="1670" y="120" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_E03" bpmnElement="p1_E03">
        <dc:Bounds x="1509" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_p1_E16" bpmnElement="p1_E16">
