<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DEV" targetNamespace="http://movecity.ucb.br/bpmn">
  <bpmn:collaboration id="Collab_DEV">
    <bpmn:participant id="Part_Desenvolvedor" name="Desenvolvedor" processRef="Process_Desenvolvedor"/>
    <bpmn:participant id="Part_Revisor" name="Revisor" processRef="Process_Revisor"/>
    <bpmn:participant id="Part_PipelineCICD" name="Pipeline CI/CD" processRef="Process_PipelineCICD"/>
    <bpmn:messageFlow id="Mdev_0" sourceRef="A05" targetRef="E11" name="PR aberto/atualizado, solicita CI"/>
    <bpmn:messageFlow id="Mdev_1" sourceRef="E12" targetRef="E02" name="Resultado do CI: verde"/>
    <bpmn:messageFlow id="Mdev_2" sourceRef="E12b" targetRef="E02" name="Resultado do CI: falha"/>
    <bpmn:messageFlow id="Mdev_3" sourceRef="A05" targetRef="E09" name="PR vinculado à issue, solicitação de review"/>
    <bpmn:messageFlow id="Mdev_4" sourceRef="E10" targetRef="E03" name="Decisão do review"/>
    <bpmn:messageFlow id="Mdev_5" sourceRef="A09" targetRef="E14" name="Merge realizado em homolog"/>
    <bpmn:messageFlow id="Mdev_6" sourceRef="E13" targetRef="E04" name="Deploy em homolog concluído"/>
    <bpmn:messageFlow id="Mdev_7" sourceRef="A14" targetRef="E14" name="Merge realizado em main"/>
    <bpmn:messageFlow id="Mdev_8" sourceRef="E13" targetRef="E07" name="Deploy em produção concluído"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Desenvolvedor" isExecutable="false">
    <bpmn:startEvent id="E01" name="US selecionada (DOR atendido)"/>
    <bpmn:userTask id="A01" name="Ler US, PRD/SPEC e diagrama de sequência"/>
    <bpmn:userTask id="A02" name="Criar branch (homolog ou main, conforme o tipo)"/>
    <bpmn:userTask id="A03" name="Desenvolver com apoio do agente de IA (planejar, codificar, testar local)"/>
    <bpmn:exclusiveGateway id="G01" name="Testes locais passam?"/>
    <bpmn:userTask id="A04" name="Corrigir com o agente e retestar"/>
    <bpmn:userTask id="A05" name="Commit Conventional Commits (sem atribuição de IA) e abrir PR"/>
    <bpmn:intermediateCatchEvent id="E02" name="Receber resultado do CI">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G02" name="CI passou?"/>
    <bpmn:manualTask id="A06" name="Corrigir conforme falha do CI"/>
    <bpmn:intermediateCatchEvent id="E03" name="Receber decisão do review">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G03" name="Aprovação formal (Review -&gt; Approve) recebida?"/>
    <bpmn:manualTask id="A07" name="Ajustar conforme comentários do review"/>
    <bpmn:exclusiveGateway id="G04" name="Bypass excepcional e deliberado (ex.: teste do pipeline)?"/>
    <bpmn:userTask id="A08" name="Registrar bypass explicitamente na issue, com justificativa"/>
    <bpmn:userTask id="A09" name="Confirmar merge em homolog (decisão sempre humana)"/>
    <bpmn:intermediateCatchEvent id="E04" name="Receber confirmação de deploy em homolog">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A10" name="Validar critérios de aceite (BDD) em homolog"/>
    <bpmn:exclusiveGateway id="G05" name="Critérios atendidos em homolog?"/>
    <bpmn:manualTask id="A11" name="Retomar desenvolvimento com o agente"/>
    <bpmn:userTask id="A12" name="Comentar resultado na issue (DoD-Sprint)"/>
    <bpmn:endEvent id="E05" name="US concluída na sprint (DoD-Sprint)"/>
    <bpmn:userTask id="A13" name="Abrir PR homolog -&gt; main (em lote, fim da sprint)"/>
    <bpmn:intermediateCatchEvent id="E06" name="Receber aprovação do PR homolog-&gt;main">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A14" name="Confirmar merge em main (decisão sempre humana)"/>
    <bpmn:intermediateCatchEvent id="E07" name="Receber confirmação de deploy em produção">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A15" name="Validar endpoint/tela real em produção"/>
    <bpmn:exclusiveGateway id="G06" name="Validado em produção?"/>
    <bpmn:manualTask id="A16" name="Investigar e corrigir com o agente"/>
    <bpmn:userTask id="A17" name="Fechar issue e atualizar documentação"/>
    <bpmn:endEvent id="E08" name="Incremento entregue em produção (DoD-Release)"/>
    <bpmn:sequenceFlow id="Fdev_0" sourceRef="E01" targetRef="A01"/>
    <bpmn:sequenceFlow id="Fdev_1" sourceRef="A01" targetRef="A02"/>
    <bpmn:sequenceFlow id="Fdev_2" sourceRef="A02" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_3" sourceRef="A03" targetRef="G01"/>
    <bpmn:sequenceFlow id="Fdev_4" sourceRef="G01" targetRef="A05" name="Sim"/>
    <bpmn:sequenceFlow id="Fdev_5" sourceRef="G01" targetRef="A04" name="Não"/>
    <bpmn:sequenceFlow id="Fdev_6" sourceRef="A04" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_7" sourceRef="A05" targetRef="E02"/>
    <bpmn:sequenceFlow id="Fdev_8" sourceRef="E02" targetRef="G02"/>
    <bpmn:sequenceFlow id="Fdev_9" sourceRef="G02" targetRef="E03" name="Sim - CI passou"/>
    <bpmn:sequenceFlow id="Fdev_10" sourceRef="G02" targetRef="A06" name="Não"/>
    <bpmn:sequenceFlow id="Fdev_11" sourceRef="A06" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_12" sourceRef="E03" targetRef="G03"/>
    <bpmn:sequenceFlow id="Fdev_13" sourceRef="G03" targetRef="A09" name="Sim - aprovação formal"/>
    <bpmn:sequenceFlow id="Fdev_14" sourceRef="G03" targetRef="G04" name="Não"/>
    <bpmn:sequenceFlow id="Fdev_15" sourceRef="G04" targetRef="A08" name="Sim - bypass excepcional"/>
    <bpmn:sequenceFlow id="Fdev_16" sourceRef="G04" targetRef="A07" name="Não - regra geral"/>
    <bpmn:sequenceFlow id="Fdev_17" sourceRef="A07" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_18" sourceRef="A08" targetRef="A09"/>
    <bpmn:sequenceFlow id="Fdev_19" sourceRef="A09" targetRef="E04"/>
    <bpmn:sequenceFlow id="Fdev_20" sourceRef="E04" targetRef="A10"/>
    <bpmn:sequenceFlow id="Fdev_21" sourceRef="A10" targetRef="G05"/>
    <bpmn:sequenceFlow id="Fdev_22" sourceRef="G05" targetRef="A12" name="Sim"/>
    <bpmn:sequenceFlow id="Fdev_23" sourceRef="G05" targetRef="A11" name="Não"/>
    <bpmn:sequenceFlow id="Fdev_24" sourceRef="A11" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_25" sourceRef="A12" targetRef="E05"/>
    <bpmn:sequenceFlow id="Fdev_26" sourceRef="E05" targetRef="A13" name="Em lote, fim da sprint"/>
    <bpmn:sequenceFlow id="Fdev_27" sourceRef="A13" targetRef="E06"/>
    <bpmn:sequenceFlow id="Fdev_28" sourceRef="E06" targetRef="A14"/>
    <bpmn:sequenceFlow id="Fdev_29" sourceRef="A14" targetRef="E07"/>
    <bpmn:sequenceFlow id="Fdev_30" sourceRef="E07" targetRef="A15"/>
    <bpmn:sequenceFlow id="Fdev_31" sourceRef="A15" targetRef="G06"/>
    <bpmn:sequenceFlow id="Fdev_32" sourceRef="G06" targetRef="A17" name="Sim"/>
    <bpmn:sequenceFlow id="Fdev_33" sourceRef="G06" targetRef="A16" name="Não"/>
    <bpmn:sequenceFlow id="Fdev_34" sourceRef="A16" targetRef="A03"/>
    <bpmn:sequenceFlow id="Fdev_35" sourceRef="A17" targetRef="E08"/>
  </bpmn:process>
  <bpmn:process id="Process_Revisor" isExecutable="false">
    <bpmn:startEvent id="E09" name="PR recebido para revisão">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="A18" name="Analisar mudanças do PR (Files changed)"/>
    <bpmn:exclusiveGateway id="G07" name="Código atende ao padrão e à US?"/>
    <bpmn:userTask id="A19" name="Comentar solicitando ajustes (não conta como aprovação)"/>
    <bpmn:userTask id="A20" name="Submeter review formal (Review changes -&gt; Approve)"/>
    <bpmn:endEvent id="E10" name="Decisão de review enviada">
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Frv_0" sourceRef="E09" targetRef="A18"/>
    <bpmn:sequenceFlow id="Frv_1" sourceRef="A18" targetRef="G07"/>
    <bpmn:sequenceFlow id="Frv_2" sourceRef="G07" targetRef="A20" name="Sim"/>
    <bpmn:sequenceFlow id="Frv_3" sourceRef="G07" targetRef="A19" name="Não"/>
    <bpmn:sequenceFlow id="Frv_4" sourceRef="A19" targetRef="E10"/>
    <bpmn:sequenceFlow id="Frv_5" sourceRef="A20" targetRef="E10"/>
  </bpmn:process>
  <bpmn:process id="Process_PipelineCICD" isExecutable="false">
    <bpmn:startEvent id="E11" name="PR aberto ou atualizado">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A21" name="Rodar lint, pytest, Jest"/>
    <bpmn:exclusiveGateway id="G08" name="Todos os testes passam?"/>
    <bpmn:endEvent id="E12" name="Resultado do CI (verde) enviado">
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E12b" name="Resultado do CI (falha) enviado">
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:startEvent id="E14" name="Merge realizado em homolog ou main">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A22" name="Disparar deploy automático (Fly.io / Vercel)"/>
    <bpmn:endEvent id="E13" name="Deploy concluído">
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fci_0" sourceRef="E11" targetRef="A21"/>
    <bpmn:sequenceFlow id="Fci_1" sourceRef="A21" targetRef="G08"/>
    <bpmn:sequenceFlow id="Fci_2" sourceRef="G08" targetRef="E12" name="Sim"/>
    <bpmn:sequenceFlow id="Fci_3" sourceRef="G08" targetRef="E12b" name="Não"/>
    <bpmn:sequenceFlow id="Fci_4" sourceRef="E14" targetRef="A22"/>
    <bpmn:sequenceFlow id="Fci_5" sourceRef="A22" targetRef="E13"/>
  </bpmn:process>
