@startuml
hide footbox
title UC15 - Buscar Linha por Número

actor "Passageiro" as passageiro

participant ":BuscaView" as view <<view>>
participant ":BuscaController" as ctrl <<controller>>
participant ":SessaoModel" as sessao <<model>>
participant ":LinhaModel" as model <<model>>

passageiro -> view : informarNumeroLinha(numero)
activate view

  view -> ctrl : buscarLinha(numero)
  activate ctrl

    ctrl -> sessao : validarSessao(token)
    activate sessao

    alt sessão válida
      sessao --> ctrl : sessaoValida()
      deactivate sessao

    else token de acesso expirado
      sessao --> ctrl : tokenExpirado()
      deactivate sessao

      ctrl -> sessao : renovarSessao(refreshToken)
      activate sessao

      alt renovação bem-sucedida
        sessao --> ctrl : novoToken()
        deactivate sessao

      else refresh token inválido ou revogado
        sessao --> ctrl : sessaoInvalida()
        deactivate sessao

        ctrl --> view : redirecionarParaLogin()
        deactivate ctrl
        view -> view : exibirTelaLoginComAviso("Sua sessão expirou. Faça login novamente.")
        deactivate view
        stop
      end
    end

    ctrl -> model : consultarLinhaPorNumero(numero)
    activate model

    alt linha encontrada
      model --> ctrl : dadosLinha(numero, itinerario, sentido, horarios)
      deactivate model

      ctrl --> view : resultadoBusca(dadosLinha)
      deactivate ctrl

      view -> view : exibirHorariosPrevistos()
      view -> view : exibirItinerario()
      view -> view : exibirSentido()

    else linha não encontrada
      model --> ctrl : linhaInexistente()
      deactivate model

      ctrl --> view : erroBuscaSemResultado()
      deactivate ctrl

      view -> view : exibirMensagemLinhaInexistente()
    end

deactivate view
@enduml
