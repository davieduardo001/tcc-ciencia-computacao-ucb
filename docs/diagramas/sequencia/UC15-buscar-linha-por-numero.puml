@startuml UC15_BuscarLinha
hide footbox
title Diagrama de Sequencia - Buscar Linha por Numero (US #15)

actor "Passageiro" as Passageiro

participant ":TelaBusca" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoLinhas" as Service <<servico linhas>>
participant ":ModeloLinha" as Model <<modelo>>

Passageiro -> View : informarNumeroLinha(numero)
activate View

View -> Gateway : requisicao(token, numero)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : consultarLinhaPorNumero(numero)
  activate Model

  alt linha encontrada
    Model --> Service : dadosLinha(numero, itinerario, sentido, horarios)
    deactivate Model
    Service --> Gateway : resposta(dadosLinha)
    deactivate Service
    Gateway --> View : retornarResposta(dadosLinha)
    View -> View : exibirHorariosPrevistos()
    View -> View : exibirItinerario()
    View -> View : exibirSentido()

  else linha nao encontrada
    Model --> Service : linhaInexistente()
    deactivate Model
    Service --> Gateway : respostaErro(linhaInexistente)
    deactivate Service
    Gateway --> View : retornarResposta(linhaInexistente)
    View -> View : exibirMensagemLinhaInexistente()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : consultarLinhaPorNumero(numero)
  activate Model
  Model --> Service : dadosLinha(numero, itinerario, sentido, horarios)
  deactivate Model
  Service --> Gateway : resposta(dadosLinha)
  deactivate Service
  Gateway --> View : retornarResposta(dadosLinha)
  View -> View : exibirHorariosPrevistos()
  View -> View : exibirItinerario()
  View -> View : exibirSentido()

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
