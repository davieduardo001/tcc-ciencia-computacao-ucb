@startuml UC13_RecuperacaoSenha
hide footbox
title Diagrama de Sequencia - Recuperação de Senha (US #13)

actor "Passageiro" as Passageiro

participant ":TelaEsqueciSenha" as ViewSol <<interface usuario>>
participant ":TelaRedefinirSenha" as ViewRedef <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloUsuario" as User <<modelo>>
participant ":ModeloTokenReset" as Token <<modelo>>
participant ":ServicoEmail" as Email <<servico externo>>

note over Passageiro, Email
  Estas rotas sao publicas: nao exigem sessao, por isso nao ha validacao de token de sessao no Gateway.
  O link do e-mail aponta para a tela de redefinicao do frontend (endereco do frontend configurado no servico).
end note

== Fase 1: Solicitacao de Reset ==

Passageiro -> ViewSol : informarEmail(email)
activate ViewSol

ViewSol -> Gateway : requisicaoResetSenha(email)
activate Gateway

Gateway -> Auth : processarSolicitacaoReset(email)
activate Auth

Auth -> Auth : verificarRateLimit(email)

alt dentro do limite
    Auth -> User : buscarPorEmail(email)
    activate User

    alt usuario existe
        User --> Auth : dadosUsuario(id, nome)
        deactivate User
        Auth -> Token : registrarToken(usuarioId, hashDoToken, validade 60 min)
        activate Token
        Token --> Auth : tokenRegistrado
        deactivate Token
        Auth -> Auth : agendarEnvioDoEmailEmSegundoPlano(email, token)
    else usuario nao existe
        User --> Auth : inexistente()
        deactivate User
        note right of Auth : Nada e gerado nem enviado.\nA resposta e igual a do e-mail cadastrado.
    end

    Auth --> Gateway : solicitacaoProcessada()
    Gateway --> ViewSol : retornarResposta(sucessoGenerico)
    ViewSol -> ViewSol : exibirMensagem("Se o e-mail estiver cadastrado, voce recebera um link de redefinicao.")

    opt envio agendado (apenas para e-mail cadastrado, apos a resposta)
        Auth ->> Email : enviarEmailReset(email, linkComTokenParaOFrontend)
        activate Email
        alt envio realizado
            Email --> Auth : e-mailEnviadoAoServidorDeEmail
        else servico de e-mail nao configurado ou falha no envio
            Email --> Auth : envioFalhou()
            note right of Auth : Apenas registrado em log, sem expor token ou senha.\nO usuario nao e avisado da falha.
        end
        deactivate Email
    end
    deactivate Auth

else limite excedido
    Auth --> Gateway : erroRateLimit()
    deactivate Auth
    Gateway --> ViewSol : retornarResposta(erroRateLimit)
    ViewSol -> ViewSol : exibirAvisoMuitasTentativas()
end

deactivate Gateway
deactivate ViewSol

== Fase 2: Redefinicao de Senha ==

Passageiro -> ViewRedef : acessarLinkDoEmail(token)
activate ViewRedef

alt link sem token
    ViewRedef -> ViewRedef : exibirErro("Este link de redefinicao nao e mais valido ou esta incompleto.")
    ViewRedef -> ViewRedef : oferecerSolicitarNovoLink()

else link com token
    ViewRedef -> ViewRedef : exibirCamposNovaSenha()
    note right of ViewRedef : O token so e conferido ao enviar a nova senha.

    Passageiro -> ViewRedef : informarNovaSenha(senha, confirmacao)
    ViewRedef -> ViewRedef : validarSenhasIguaisEMinimoDe8Caracteres(senha, confirmacao)

    alt senhas validas no formulario
        ViewRedef -> Gateway : atualizarSenha(token, novaSenha, confirmacao)
        activate Gateway
        Gateway -> Auth : redefinirSenha(token, novaSenha, confirmacao)
        activate Auth

        Auth -> Auth : validarSenhas(novaSenha, confirmacao)
        Auth -> Token : buscarPorHash(hash(token))
        activate Token

        alt token existe, nao foi usado e nao expirou
            Token --> Auth : tokenValido(usuarioId)
            Auth -> User : atualizarSenha(usuarioId, hash(novaSenha))
            activate User
            User --> Auth : senhaAtualizada
            deactivate User
            Auth -> Token : marcarComoUsado()
            Token --> Auth : tokenInvalidado
            deactivate Token
            Auth --> Gateway : senhaRedefinida()
            deactivate Auth
            Gateway --> ViewRedef : retornarResposta(sucesso)
            ViewRedef -> ViewRedef : exibirConfirmacaoSucesso()
            ViewRedef -> ViewRedef : oferecerIrParaLogin()

        else token inexistente, usado ou expirado
            Token --> Auth : tokenInvalido()
            deactivate Token
            Auth --> Gateway : erroToken()
            deactivate Auth
            Gateway --> ViewRedef : retornarResposta(erroToken)
            ViewRedef -> ViewRedef : exibirErro("Este link nao e mais valido ou expirou.")
        end
        deactivate Gateway

    else senhas diferentes ou menores que 8 caracteres
        ViewRedef -> ViewRedef : exibirErrosDeValidacao()
    end
end

deactivate ViewRedef
@enduml
