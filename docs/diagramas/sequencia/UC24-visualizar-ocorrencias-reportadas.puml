@startuml UC24_VisualizarOcorrenciasReportadas
hide footbox
title Diagrama de Sequencia - Visualizar Ocorrencias Reportadas por Outros Passageiros (US #24)

actor "Passageiro" as Passageiro

participant ":TelaOcorrencias" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoOcorrencias" as Service <<servico ocorrencias>>
participant ":ModeloOcorrencia" as Model <<modelo>>

Passageiro -> View : acessarTelaOcorrencias(linhaId)
activate View

View -> Gateway : requisicao(token, linhaId)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : consultarOcorrenciasAtivas(linhaId)
  activate Model
  Model --> Service : ocorrencias(lista)
  deactivate Model

  Service -> Model : filtrarOcorrenciasExpiradas(lista)
  activate Model
  Model --> Service : ocorrenciasValidas(listaFiltrada)
  deactivate Model

  Service --> Gateway : resposta(ocorrenciasValidas)
  deactivate Service
  Gateway --> View : retornarResposta(ocorrenciasValidas)

  loop para cada ocorrencia na lista
    alt confirmacoes >= 2
      View -> View : exibirOcorrenciaConfirmada(ocorrencia, status: confirmado)
    else confirmacoes == 1
      View -> View : exibirOcorrenciaPendente(ocorrencia, status: pendente)
    end
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : consultarOcorrenciasAtivas(linhaId)
  activate Model
  Model --> Service : ocorrencias(lista)
  deactivate Model
  Service -> Model : filtrarOcorrenciasExpiradas(lista)
  activate Model
  Model --> Service : ocorrenciasValidas(listaFiltrada)
  deactivate Model
  Service --> Gateway : resposta(ocorrenciasValidas)
  deactivate Service
  Gateway --> View : retornarResposta(ocorrenciasValidas)
  View -> View : exibirListaOcorrencias(ocorrenciasValidas)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
