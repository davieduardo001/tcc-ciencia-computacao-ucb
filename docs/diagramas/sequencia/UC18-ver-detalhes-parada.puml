@startuml UC18_DetalhesParada
hide footbox
title Diagrama de Sequencia - Ver Detalhes de uma Parada (US #18)

actor "Passageiro" as Passageiro

participant ":TelaMapa" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoParadas" as Service <<servico paradas>>
participant ":ModeloParada" as Model <<modelo>>

Passageiro -> View : selecionarParadaNoMapa(parada)
activate View

View -> Gateway : requisicao(token, parada)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterInfoParada(parada)
  activate Model

  alt parada com dados disponiveis
    Model --> Service : infoParada(nome, codigo, linhas, proximosHorarios)
    deactivate Model
    Service --> Gateway : resposta(infoParada)
    deactivate Service
    Gateway --> View : retornarResposta(infoParada)
    View -> View : exibirPainelDetalheParada()
    View -> View : listarLinhasQuePassam(linhas)
    View -> View : exibirProximosTresHorarios(proximosHorarios)

  else parada sem horarios disponiveis
    Model --> Service : paradaSemHorarios(nome, codigo, linhas)
    deactivate Model
    Service --> Gateway : resposta(paradaSemHorarios)
    deactivate Service
    Gateway --> View : retornarResposta(paradaSemHorarios)
    View -> View : exibirPainelDetalheParada()
    View -> View : exibirAvisoHorariosIndisponiveis()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterInfoParada(parada)
  activate Model
  Model --> Service : infoParada(nome, codigo, linhas, proximosHorarios)
  deactivate Model
  Service --> Gateway : resposta(infoParada)
  deactivate Service
  Gateway --> View : retornarResposta(infoParada)
  View -> View : exibirPainelDetalheParada()
  View -> View : listarLinhasQuePassam(linhas)
  View -> View : exibirProximosTresHorarios(proximosHorarios)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

Passageiro -> View : fecharPainelDetalhe()
View -> View : ocultarPainelERetornarAoMapa()

deactivate View
@enduml
