@startuml UC22_ReceberNotificacoesRotasPreferidas
hide footbox
title Diagrama de Sequencia - Receber Notificacoes de Rotas Preferidas (US #22)

actor "Passageiro" as Passageiro

participant ":TelaNotificacao" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoNotificacoes" as Service <<servico notificacoes>>
participant ":ModeloPreferencias" as Preferencias <<modelo>>
participant ":ServicoRastreamento" as Rastreamento <<servico rastreamento>>

== Monitoramento em Segundo Plano ==

loop a cada intervalo de monitoramento
  Service -> Preferencias : consultarRotasFavoritasAtivas()
  activate Service
  activate Preferencias
  Preferencias --> Service : rotasFavoritas(lista)
  deactivate Preferencias

  Service -> Rastreamento : verificarProximidadeOnibus(rotasFavoritas)
  activate Rastreamento

  alt onibus dentro do limiar configurado e notificacoes ativas
    Rastreamento --> Service : onibusProximo(linha, tempoEstimado)
    deactivate Rastreamento
    Service -> Preferencias : obterAntecedenteConfigurado(usuarioId)
    activate Preferencias
    Preferencias --> Service : antecedencia(30min)
    deactivate Preferencias
    Service -> Passageiro : enviarPushNotification(linha, tempoEstimado)
    deactivate Service

  else notificacoes desabilitadas pelo usuario
    Rastreamento --> Service : onibusProximo(linha, tempoEstimado)
    deactivate Rastreamento
    Service -> Preferencias : obterPreferenciasNotificacao(usuarioId)
    activate Preferencias
    Preferencias --> Service : preferencias(ativa: nao)
    deactivate Preferencias
    Service -> Service : ignorarNotificacao()
    deactivate Service
  end
end

== Interacao do Passageiro com a Notificacao ==

Passageiro -> View : tocarNotificacao(linha)
activate View

View -> Gateway : requisicao(token, linhaId)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Rastreamento : obterStatusAtualLinha(linhaId)
  activate Rastreamento
  Rastreamento --> Service : statusAtual(posicao, previsaoChegada)
  deactivate Rastreamento

  Service --> Gateway : resposta(statusAtual)
  deactivate Service
  Gateway --> View : retornarResposta(statusAtual)
  View -> View : exibirDetalhesDaLinha(posicao, previsaoChegada)

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Rastreamento : obterStatusAtualLinha(linhaId)
  activate Rastreamento
  Rastreamento --> Service : statusAtual(posicao, previsaoChegada)
  deactivate Rastreamento
  Service --> Gateway : resposta(statusAtual)
  deactivate Service
  Gateway --> View : retornarResposta(statusAtual)
  View -> View : exibirDetalhesDaLinha(posicao, previsaoChegada)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
