@startuml UC25_SalvarRotaFavorita
hide footbox
title Diagrama de Sequencia - Salvar Rota Favorita (US #25)

actor "Passageiro" as Passageiro

participant ":TelaRota" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoRotas" as Service <<servico rotas>>
participant ":ModeloRotaFavorita" as Model <<modelo>>

== Salvar Rota como Favorita ==

Passageiro -> View : selecionarSalvarComoFavorita(rotaId)
activate View

View -> Gateway : requisicao(token, rotaId)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : salvarRotaFavorita(usuarioId, rotaId)
  activate Model
  Model --> Service : rotaSalva(favoritoId)
  deactivate Model

  Service --> Gateway : resposta(rotaSalva)
  deactivate Service
  Gateway --> View : retornarResposta(rotaSalva)
  View -> View : exibirConfirmacaoFavorito()
  View -> View : adicionarRotaEmMinhasRotas(favoritoId)

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : salvarRotaFavorita(usuarioId, rotaId)
  activate Model
  Model --> Service : rotaSalva(favoritoId)
  deactivate Model
  Service --> Gateway : resposta(rotaSalva)
  deactivate Service
  Gateway --> View : retornarResposta(rotaSalva)
  View -> View : exibirConfirmacaoFavorito()
  View -> View : adicionarRotaEmMinhasRotas(favoritoId)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

== Acesso Rapido a Rota Favorita ==

Passageiro -> View : acessarTelaPrincipal()

View -> Gateway : requisicao(token)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : listarRotasFavoritas(usuarioId)
  activate Model
  Model --> Service : rotasFavoritas(lista)
  deactivate Model
  Service --> Gateway : resposta(rotasFavoritas)
  deactivate Service
  Gateway --> View : retornarResposta(rotasFavoritas)
  View -> View : exibirRotasFavoritasEmDestaque(lista)

else token invalido ou expirado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

== Remover Rota Favorita ==

Passageiro -> View : selecionarRemoverFavorito(favoritoId)

View -> Gateway : requisicao(token, favoritoId)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : removerRotaFavorita(usuarioId, favoritoId)
  activate Model
  Model --> Service : rotaRemovida()
  deactivate Model
  Service --> Gateway : resposta(rotaRemovida)
  deactivate Service
  Gateway --> View : retornarResposta(rotaRemovida)
  View -> View : removerRotaDaLista(favoritoId)

else token invalido ou expirado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
