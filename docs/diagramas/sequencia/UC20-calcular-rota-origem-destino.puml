@startuml UC20_CalcularRota
hide footbox
title Diagrama de Sequencia - Calcular Rota de Origem ate Destino por Onibus (US #20)

actor "Passageiro" as Passageiro

participant ":TelaRota" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoRotas" as Service <<servico rotas>>
participant ":ModeloRota" as Model <<modelo>>

Passageiro -> View : informarOrigemEDestino(origem, destino)
activate View

View -> Gateway : requisicao(token, origem, destino)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : geocodificarEnderecos(origem, destino)
  activate Model
  Model --> Service : coordenadasOrigemDestino(latOrig, lngOrig, latDest, lngDest)
  deactivate Model

  Service -> Model : calcularMelhorRota(coordOrigem, coordDestino)
  activate Model

  alt rota simples encontrada
    Model --> Service : rotaSimples(linha, paradas, horarios)
    deactivate Model
    Service --> Gateway : resposta(rotaSimples)
    deactivate Service
    Gateway --> View : retornarResposta(rotaSimples)
    View -> View : exibirTrajetoNoMapa(linha)
    View -> View : listarParadasEHorarios()

  else rota com baldeacao encontrada
    Model --> Service : rotaComBaldeacao(trechos, pontosDeBaldeacao)
    deactivate Model
    Service --> Gateway : resposta(rotaComBaldeacao)
    deactivate Service
    Gateway --> View : retornarResposta(rotaComBaldeacao)
    View -> View : exibirTrechosNoMapa(trechos)
    View -> View : destacarPontosDeBaldeacao()

  else nenhuma rota disponivel
    Model --> Service : semRotaDisponivel()
    deactivate Model
    Service --> Gateway : respostaErro(semRota)
    deactivate Service
    Gateway --> View : retornarResposta(semRota)
    View -> View : exibirMensagemSemRota()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : geocodificarEnderecos(origem, destino)
  activate Model
  Model --> Service : coordenadasOrigemDestino(latOrig, lngOrig, latDest, lngDest)
  deactivate Model
  Service -> Model : calcularMelhorRota(coordOrigem, coordDestino)
  activate Model
  Model --> Service : rotaSimples(linha, paradas, horarios)
  deactivate Model
  Service --> Gateway : resposta(rotaSimples)
  deactivate Service
  Gateway --> View : retornarResposta(rotaSimples)
  View -> View : exibirTrajetoNoMapa(linha)
  View -> View : listarParadasEHorarios()

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

opt trecho com ocorrencia ativa
  View -> Gateway : verificarOcorrenciasNaRota(token, rota)
  activate Gateway
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : consultarOcorrenciasAtivas(rota)
  activate Model
  Model --> Service : ocorrencias(lista)
  deactivate Model
  Service --> Gateway : resposta(ocorrencias)
  deactivate Service
  Gateway --> View : retornarResposta(ocorrencias)
  deactivate Gateway
  View -> View : exibirAlertasNoTrechoAfetado()
end

deactivate View
@enduml
