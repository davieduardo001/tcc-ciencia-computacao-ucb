@startuml UC27_ReceberAlertaAtrasoLinha
hide footbox
title Diagrama de Sequencia - Receber Alerta de Atraso na Linha Acompanhada (US #27)

actor "Passageiro" as Passageiro

participant ":TelaRastreamento" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoRastreamento" as Service <<servico rastreamento>>
participant ":ModeloLinha" as Model <<modelo>>

== Monitoramento de Atraso em Segundo Plano ==

loop a cada ciclo de monitoramento
  Service -> Model : consultarLinhasAcompanhadas()
  activate Service
  activate Model
  Model --> Service : linhasAtivas(lista)
  deactivate Model

  Service -> Model : calcularDesvioHorario(linhasAtivas)
  activate Model

  alt atraso detectado superior a 10 minutos
    Model --> Service : desvio(linha, atrasoMinutos: > 10)
    deactivate Model
    Service -> Passageiro : enviarAlertaAtraso(linha, atrasoMinutos)
    deactivate Service

  else atraso normalizado (abaixo de 5 minutos)
    Model --> Service : desvio(linha, atrasoMinutos: < 5)
    deactivate Model
    Service -> Passageiro : enviarAvisoCancelamentoAlerta(linha, "O onibus voltou ao horario previsto.")
    deactivate Service

  else atraso dentro da tolerancia
    Model --> Service : desvio(linha, atrasoMinutos: toleravel)
    deactivate Model
    Service -> Service : manterMonitoramento()
    deactivate Service
  end
end

== Interacao do Passageiro com o Alerta ==

Passageiro -> View : tocarAlertaAtraso(linhaId)
activate View

View -> Gateway : requisicao(token, linhaId)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterStatusAtualizado(linhaId)
  activate Model
  Model --> Service : statusLinha(posicaoAtual, previsaoChegada, atrasoAtual)
  deactivate Model

  Service --> Gateway : resposta(statusLinha)
  deactivate Service
  Gateway --> View : retornarResposta(statusLinha)

  alt atraso aumentou desde ultimo alerta
    View -> View : atualizarAlertaComNovoAtraso(atrasoAtual)
    View -> View : exibirMensagem("Atencao: o onibus [linha] esta com atraso de aproximadamente X minutos.")
  else atraso normalizou
    View -> View : exibirMensagem("O onibus [linha] voltou ao horario previsto.")
    View -> View : encerrarAlertaDeAtraso()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterStatusAtualizado(linhaId)
  activate Model
  Model --> Service : statusLinha(posicaoAtual, previsaoChegada, atrasoAtual)
  deactivate Model
  Service --> Gateway : resposta(statusLinha)
  deactivate Service
  Gateway --> View : retornarResposta(statusLinha)
  View -> View : atualizarAlertaComNovoAtraso(atrasoAtual)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
