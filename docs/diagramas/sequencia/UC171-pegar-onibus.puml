@startuml UC171_PegarOnibus
hide footbox
title Diagrama de Sequencia - Pegar o Onibus: Indicar Embarque e Acompanhar a Viagem (US #171)

actor "Passageiro" as Passageiro

participant ":TelaRastreamento" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoViagem" as Service <<servico mobilidade>>
participant ":ModeloVeiculo" as Veiculo <<modelo>>
participant ":ModeloViagem" as Model <<modelo>>

note over Passageiro, Model
  O embarque se confirma por uma de duas regras, nesta ordem:
  (1) onibus da linha a ate o raio de embarque do passageiro (padrao 100 m, configuravel no servico);
  (2) onibus da linha que chega, em ate 2 min, a uma parada da linha a ate 400 m do passageiro.
  Os limites de 400 m e 2 min sao configuraveis e estao marcados como "a validar em campo" (issue #190).
  Fora de escopo, nao entregue: compartilhamento colaborativo da posicao do onibus (US #199, em aberto).
end note

== Indicar o Embarque ==

Passageiro -> View : tocarPegueiEsteOnibus(linha, prefixoDoOnibus?, paradaDestino?)
activate View

View -> View : obterPosicaoDoPassageiro()

View -> Gateway : requisicao(token, linha, posicaoPassageiro, prefixoDoOnibus?, paradaDestino?)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : consultarViagemAtiva(identidadeUsuario)
  activate Model
  Model --> Service : viagemAtiva | nenhuma
  deactivate Model

  alt passageiro ja esta em viagem
    Service --> Gateway : respostaErro(conflito, 409)
    deactivate Service
    Gateway --> View : retornarResposta(conflito)
    View -> View : exibirAviso("Voce ja esta em uma viagem.")

  else sem viagem ativa
    opt parada de destino informada
      Service -> Service : validarParadaDeDestino(linha, paradaDestino)
    end

    alt parada de destino desconhecida ou fora da linha
      Service --> Gateway : respostaErro(paradaInvalida, 422)
      deactivate Service
      Gateway --> View : retornarResposta(paradaInvalida)
      View -> View : exibirAviso(motivo)

    else destino valido ou nao informado
      Service -> Veiculo : obterVeiculosProximos(linha, prefixoDoOnibus?, posicaoPassageiro, raioDeEmbarque)
      activate Veiculo
      note right of Veiculo : Com o prefixo informado (popup de um onibus),\nsomente esse onibus pode confirmar o embarque.

      alt regra 1: onibus da linha dentro do raio, com posicao recente
        Veiculo --> Service : veiculoMaisProximo(prefixo, sentido)
        deactivate Veiculo

      else nenhum onibus dentro do raio
        Veiculo --> Service : semVeiculoProximo()
        deactivate Veiculo
        Service -> Veiculo : obterOnibusQueChegaAParadaDoPassageiro(linha, posicaoPassageiro, 400 m, ate 2 min)
        activate Veiculo
        note right of Veiculo : Sem parada ingerida por perto, ou onibus parado,\nde sentido oposto, que ja passou ou com posicao velha:\nnao vale, e nao ha estimativa em linha reta.

        alt regra 2: onibus chegando a parada do passageiro
          Veiculo --> Service : veiculoChegando(prefixo, sentido)
          deactivate Veiculo
        else nenhum onibus identificavel
          Veiculo --> Service : semVeiculoChegando()
          deactivate Veiculo
        end
      end

      alt onibus identificado
        note right of Service : A posicao do passageiro so confirma o\nembarque e e descartada (LGPD).\nNada de trilha de posicao.
        Service -> Model : registrarViagem(identidadeUsuario, linha, sentido, prefixo, paradaDestino?)
        activate Model
        Model --> Service : viagemRegistrada
        deactivate Model
        Service --> Gateway : resposta(viagemRegistrada, 201)
        deactivate Service
        Gateway --> View : retornarResposta(viagemRegistrada)
        View -> View : passarParaModoEmViagem(viagemRegistrada)

      else nenhum veiculo identificavel
        Service --> Gateway : respostaErro(naoConfirmado, 422)
        deactivate Service
        Gateway --> View : retornarResposta(naoConfirmado)
        View -> View : exibirAviso("Nenhum onibus desta linha esta perto de voce agora.")
      end
    end
  end

else token expirado ou ausente
  Gateway --> View : notificarNaoAutorizado(401)

  View -> Gateway : renovarSessao(refreshToken)
  activate Gateway
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao

  alt sessao ainda ativa
    Sessao --> Auth : tokenValido
    deactivate Sessao
    Auth -> Sessao : emitirNovosTokens(usuarioId)
    activate Sessao
    Sessao --> Auth : novosTokens
    deactivate Sessao
    Auth --> Gateway : sessaoRenovada(novosTokens)
    deactivate Auth
    Gateway --> View : retornarResposta(sessaoRenovada)
    deactivate Gateway

    View -> Gateway : requisicao(novoToken, linha, posicaoPassageiro, prefixoDoOnibus?, paradaDestino?)
    activate Gateway
    Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
    activate Service
    Service --> Gateway : resposta(viagemRegistrada, 201) | respostaErro
    deactivate Service
    Gateway --> View : retornarResposta(viagemRegistrada | erro)
    deactivate Gateway
    View -> View : passarParaModoEmViagemOuExibirAviso()

  else refresh revogado ou invalido
    Sessao --> Auth : sessaoInexistente()
    deactivate Sessao
    Auth --> Gateway : erroNaoAutorizado(401)
    deactivate Auth
    Gateway --> View : notificarNaoAutorizado(401)
    deactivate Gateway
    View -> View : redirecionarParaLogin("Sua sessao expirou, entre novamente.")
  end
end

deactivate Gateway
deactivate View

== Escolher o Destino (opcional, depois de embarcar) ==

Passageiro -> View : tocarDescerNestaParada(paradaTocadaNoMapa)
activate View
View -> Gateway : requisicao(token, viagemId, paradaDestino)
activate Gateway
Gateway -> Gateway : verificarAssinaturaToken(token)
Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
activate Service

Service -> Model : definirDestino(viagemId, identidadeUsuario, paradaDestino)
activate Model

alt viagem ativa do passageiro e parada pertence a linha
  Model --> Service : viagemAtualizada
  deactivate Model
  Service --> Gateway : resposta(viagemAtualizada)
  deactivate Service
  Gateway --> View : retornarResposta(viagemAtualizada)
  View -> View : exibirParadasRestantesAteODestino()

else viagem encerrada, de outro passageiro ou parada invalida
  Model --> Service : recusada(motivo)
  deactivate Model
  Service --> Gateway : respostaErro(409 | 404 | 422)
  deactivate Service
  Gateway --> View : retornarResposta(erro)
  View -> View : exibirAviso(motivo)
end

deactivate Gateway
deactivate View

== Acompanhar a Viagem ==

note over View, Service
  A mesma consulta devolve o aviso de proximidade da parada de destino, quando houver (ver UC172).
end note

loop enquanto em viagem (a cada atualizacao da posicao ao vivo)
  View -> Gateway : requisicao(token)
  activate View
  activate Gateway
  Gateway -> Gateway : verificarAssinaturaToken(token)
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : consultarViagemAtiva(identidadeUsuario)
  activate Model
  Model --> Service : viagemAtiva
  deactivate Model

  Service -> Model : expirarSeVencida(viagemAtiva)
  activate Model
  Model --> Service : viagemAtiva | encerradaPorExpiracao
  deactivate Model

  Service -> Veiculo : obterPosicaoDoVeiculo(prefixo)
  activate Veiculo

  alt veiculo com posicao recente e trajeto conhecido
    Veiculo --> Service : posicaoAoVivo
    deactivate Veiculo
    Service -> Service : calcularProximaParadaEParadasRestantes(posicaoAoVivo, paradaDestino)
    Service --> Gateway : resposta(veiculo, proximaParada, paradasRestantes)
    deactivate Service
    Gateway --> View : retornarResposta(progresso)
    View -> View : exibirVeiculoProximaParadaEParadasRestantes(progresso)

  else veiculo sem sinal ou sentido desconhecido
    Veiculo --> Service : semPosicaoRecente()
    deactivate Veiculo
    Service --> Gateway : resposta(semSinal)
    deactivate Service
    Gateway --> View : retornarResposta(semSinal)
    View -> View : exibirAvisoSemSinalSemEstimar()
  end

  deactivate Gateway
  deactivate View
end

== Encerrar a Viagem ==

Passageiro -> View : tocarCheguei()
activate View
View -> Gateway : requisicao(token, viagemId)
activate Gateway
Gateway -> Gateway : verificarAssinaturaToken(token)
Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
activate Service

Service -> Model : encerrarViagem(viagemId, identidadeUsuario)
activate Model

alt viagem do passageiro (ou ja encerrada)
  Model --> Service : viagemEncerrada
  deactivate Model
  Service --> Gateway : resposta(viagemEncerrada)
  deactivate Service
  Gateway --> View : retornarResposta(viagemEncerrada)
  View -> View : voltarAoEstadoNormal()

else viagem inexistente ou de outro passageiro
  Model --> Service : naoEncontrada()
  deactivate Model
  Service --> Gateway : respostaErro(naoEncontrada, 404)
  deactivate Service
  Gateway --> View : retornarResposta(naoEncontrada)
  View -> View : voltarAoEstadoNormal()
end

deactivate Gateway
deactivate View

@enduml
