@startuml
hide footbox
title UC17 - Visualizar Trajeto e Paradas da Linha no Mapa

actor "Passageiro" as passageiro

participant ":MapaLinhaView" as view <<view>>
participant ":LinhaController" as ctrl <<controller>>
participant ":SessaoModel" as sessao <<model>>
participant ":LinhaModel" as model <<model>>

passageiro -> view : selecionarLinha(linha)
activate view

  view -> ctrl : carregarTrajetoLinha(linha)
  activate ctrl

    ctrl -> sessao : validarSessao(token)
    activate sessao

    alt sessão válida
      sessao --> ctrl : sessaoValida()
      deactivate sessao

    else token de acesso expirado
      sessao --> ctrl : tokenExpirado()
      deactivate sessao

      ctrl -> sessao : renovarSessao(refreshToken)
      activate sessao

      alt renovação bem-sucedida
        sessao --> ctrl : novoToken()
        deactivate sessao

      else refresh token inválido ou revogado
        sessao --> ctrl : sessaoInvalida()
        deactivate sessao

        ctrl --> view : redirecionarParaLogin()
        deactivate ctrl
        view -> view : exibirTelaLoginComAviso("Sua sessão expirou. Faça login novamente.")
        deactivate view
        stop
      end
    end

    ctrl -> model : obterTrajetoCompleto(linha)
    activate model
    model --> ctrl : dadosTrajeto(pontos, paradas, sentido)
    deactivate model

  ctrl --> view : trajetoCarregado(pontos, paradas, sentido)
  deactivate ctrl

  view -> view : desenharPolilinhaColoridaNoMapa(pontos)
  view -> view : exibirSetaDirecional(sentido)
  view -> view : marcarParadasNoTrajeto(paradas)

deactivate view

passageiro -> view : tocarParadaNoMapa(parada)
activate view
  view -> view : exibirNomeParada(parada)
deactivate view
@enduml
