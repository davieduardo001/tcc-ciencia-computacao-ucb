@startuml UC17_VisualizarTrajeto
hide footbox
title Diagrama de Sequencia - Visualizar Trajeto e Paradas da Linha no Mapa (US #17)

actor "Passageiro" as Passageiro

participant ":TelaMapa" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoLinhas" as Service <<servico linhas>>
participant ":ModeloLinha" as Model <<modelo>>

Passageiro -> View : selecionarLinha(linha)
activate View

View -> Gateway : requisicao(token, linha)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterTrajetoCompleto(linha)
  activate Model
  Model --> Service : dadosTrajeto(pontos, paradas, sentido)
  deactivate Model

  Service --> Gateway : resposta(dadosTrajeto)
  deactivate Service
  Gateway --> View : retornarResposta(dadosTrajeto)
  View -> View : desenharPolilinhaColoridaNoMapa(pontos)
  View -> View : exibirSetaDirecional(sentido)
  View -> View : marcarParadasNoTrajeto(paradas)

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterTrajetoCompleto(linha)
  activate Model
  Model --> Service : dadosTrajeto(pontos, paradas, sentido)
  deactivate Model
  Service --> Gateway : resposta(dadosTrajeto)
  deactivate Service
  Gateway --> View : retornarResposta(dadosTrajeto)
  View -> View : desenharPolilinhaColoridaNoMapa(pontos)
  View -> View : exibirSetaDirecional(sentido)
  View -> View : marcarParadasNoTrajeto(paradas)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

Passageiro -> View : tocarParadaNoMapa(parada)
View -> View : exibirNomeParada(parada)

deactivate View
@enduml
