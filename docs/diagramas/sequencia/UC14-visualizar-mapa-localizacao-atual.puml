@startuml
hide footbox
title UC14 - Visualizar Mapa com Localização Atual

actor "Passageiro" as passageiro

participant ":MapaView" as view <<view>>
participant ":MapaController" as ctrl <<controller>>
participant ":SessaoModel" as sessao <<model>>
participant ":LocalizacaoModel" as model <<model>>

passageiro -> view : acessarTelaPrincipal()
activate view

  view -> ctrl : solicitarLocalizacaoAtual()
  activate ctrl

    ctrl -> sessao : validarSessao(token)
    activate sessao

    alt sessão válida
      sessao --> ctrl : sessaoValida()
      deactivate sessao

    else token de acesso expirado
      sessao --> ctrl : tokenExpirado()
      deactivate sessao

      ctrl -> sessao : renovarSessao(refreshToken)
      activate sessao

      alt renovação bem-sucedida
        sessao --> ctrl : novoToken()
        deactivate sessao

      else refresh token inválido ou revogado
        sessao --> ctrl : sessaoInvalida()
        deactivate sessao

        ctrl --> view : redirecionarParaLogin()
        deactivate ctrl
        view -> view : exibirTelaLoginComAviso("Sua sessão expirou. Faça login novamente.")
        deactivate view
        stop
      end
    end

    ctrl -> model : obterPosicaoGPS()
    activate model

    alt permissão de localização concedida
      model --> ctrl : coordenadas(lat, lng)
      deactivate model

      ctrl --> view : localizacaoObtida(lat, lng)
      deactivate ctrl

      view -> view : centralizarMapa(lat, lng)
      view -> view : exibirMarcadorPosicaoAtual()

    else permissão negada ou GPS desligado
      model --> ctrl : erroPosicaoIndisponivel()
      deactivate model

      ctrl --> view : localizacaoIndisponivel()
      deactivate ctrl

      view -> view : exibirAvisoPosicaoIndisponivel()
      view -> view : centralizarMapaPontoPadrao()
    end

deactivate view

passageiro -> view : moverseGeograficamente()
activate view

  view -> ctrl : atualizarPosicao()
  activate ctrl

    ctrl -> model : obterPosicaoGPS()
    activate model
    model --> ctrl : novasCoordenadas(lat, lng)
    deactivate model

    model -> view : notificarAtualizacao()

  ctrl --> view : posicaoAtualizada(lat, lng)
  deactivate ctrl

  view -> view : deslocarMarcadorPosicao(lat, lng)

deactivate view
@enduml
