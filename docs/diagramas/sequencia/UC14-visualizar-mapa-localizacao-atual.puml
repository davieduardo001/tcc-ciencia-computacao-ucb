@startuml UC14_VisualizarMapa
hide footbox
title Diagrama de Sequencia - Visualizar Mapa com Localizacao Atual (US #14)

actor "Passageiro" as Passageiro

participant ":TelaMapa" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoLocalizacao" as Service <<servico localizacao>>
participant ":ModeloLocalizacao" as Model <<modelo>>

Passageiro -> View : acessarTelaPrincipal()
activate View

View -> Gateway : requisicao(token)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterPosicaoGPS()
  activate Model

  alt permissao de localizacao concedida
    Model --> Service : coordenadas(lat, lng)
    deactivate Model
    Service --> Gateway : resposta(coordenadas)
    deactivate Service
    Gateway --> View : retornarResposta(coordenadas)
    View -> View : centralizarMapa(lat, lng)
    View -> View : exibirMarcadorPosicaoAtual()

  else permissao negada ou GPS desligado
    Model --> Service : erroPosicaoIndisponivel()
    deactivate Model
    Service --> Gateway : respostaErro(posicaoIndisponivel)
    deactivate Service
    Gateway --> View : retornarResposta(posicaoIndisponivel)
    View -> View : exibirAvisoPosicaoIndisponivel()
    View -> View : centralizarMapaPontoPadrao()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicaoGPS()
  activate Model
  Model --> Service : coordenadas(lat, lng)
  deactivate Model
  Service --> Gateway : resposta(coordenadas)
  deactivate Service
  Gateway --> View : retornarResposta(coordenadas)
  View -> View : centralizarMapa(lat, lng)
  View -> View : exibirMarcadorPosicaoAtual()

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

loop atualizacao em tempo real
  View -> Gateway : atualizarPosicao(token)
  activate Gateway
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicaoGPS()
  activate Model
  Model --> Service : novasCoordenadas(lat, lng)
  deactivate Model
  Service --> Gateway : resposta(novasCoordenadas)
  deactivate Service
  Gateway --> View : retornarResposta(novasCoordenadas)
  deactivate Gateway
  View -> View : deslocarMarcadorPosicao(lat, lng)
end

deactivate View
@enduml
