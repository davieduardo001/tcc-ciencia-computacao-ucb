@startuml
hide footbox
title UC16 - Rastrear Posição do Ônibus em Tempo Real

actor "Passageiro" as passageiro

participant ":RastreamentoView" as view <<view>>
participant ":RastreamentoController" as ctrl <<controller>>
participant ":SessaoModel" as sessao <<model>>
participant ":VeiculoModel" as model <<model>>

passageiro -> view : selecionarLinhaParaRastrear(linha)
activate view

  view -> ctrl : iniciarRastreamento(linha)
  activate ctrl

    ctrl -> sessao : validarSessao(token)
    activate sessao

    alt sessão válida
      sessao --> ctrl : sessaoValida()
      deactivate sessao

    else token de acesso expirado
      sessao --> ctrl : tokenExpirado()
      deactivate sessao

      ctrl -> sessao : renovarSessao(refreshToken)
      activate sessao

      alt renovação bem-sucedida
        sessao --> ctrl : novoToken()
        deactivate sessao

      else refresh token inválido ou revogado
        sessao --> ctrl : sessaoInvalida()
        deactivate sessao

        ctrl --> view : redirecionarParaLogin()
        deactivate ctrl
        view -> view : exibirTelaLoginComAviso("Sua sessão expirou. Faça login novamente.")
        deactivate view
        stop
      end
    end

    ctrl -> model : obterPosicoesVeiculos(linha)
    activate model

    alt veículos em operação
      model --> ctrl : listaVeiculos(posicoes)
      deactivate model

      ctrl --> view : veiculosLocalizados(posicoes)
      deactivate ctrl

      view -> view : exibirIconesVeiculosNoMapa(posicoes)

    else nenhum veículo em operação
      model --> ctrl : semVeiculosAtivos()
      deactivate model

      ctrl --> view : avisoSemVeiculos()
      deactivate ctrl

      view -> view : exibirAvisoSemVeiculosEmOperacao()
    end

deactivate view

loop atualização contínua
  model -> view : notificarAtualizacao()
  activate view

  view -> ctrl : solicitarAtualizacaoPosicoes(linha)
  activate ctrl

    ctrl -> model : obterPosicoesVeiculos(linha)
    activate model
    model --> ctrl : listaVeiculosAtualizada(posicoes)
    deactivate model

  ctrl --> view : posicoesAtualizadas(posicoes)
  deactivate ctrl

  view -> view : atualizarIconesVeiculosNoMapa(posicoes)
  deactivate view
end
@enduml
