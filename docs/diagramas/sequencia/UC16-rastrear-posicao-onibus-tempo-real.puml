@startuml UC16_RastrearOnibus
hide footbox
title Diagrama de Sequencia - Rastrear Posicao do Onibus em Tempo Real (US #16)

actor "Passageiro" as Passageiro

participant ":TelaRastreamento" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoRastreamento" as Service <<servico rastreamento>>
participant ":ModeloVeiculo" as Model <<modelo>>

Passageiro -> View : selecionarLinhaParaRastrear(linha)
activate View

View -> Gateway : requisicao(token, linha)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterPosicoesVeiculos(linha)
  activate Model

  alt veiculos em operacao
    Model --> Service : listaVeiculos(posicoes)
    deactivate Model
    Service --> Gateway : resposta(posicoes)
    deactivate Service
    Gateway --> View : retornarResposta(posicoes)
    View -> View : exibirIconesVeiculosNoMapa(posicoes)

  else nenhum veiculo em operacao
    Model --> Service : semVeiculosAtivos()
    deactivate Model
    Service --> Gateway : respostaErro(semVeiculos)
    deactivate Service
    Gateway --> View : retornarResposta(semVeiculos)
    View -> View : exibirAvisoSemVeiculosEmOperacao()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicoesVeiculos(linha)
  activate Model
  Model --> Service : listaVeiculos(posicoes)
  deactivate Model
  Service --> Gateway : resposta(posicoes)
  deactivate Service
  Gateway --> View : retornarResposta(posicoes)
  View -> View : exibirIconesVeiculosNoMapa(posicoes)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

loop atualizacao continua de posicoes
  View -> Gateway : atualizarPosicoes(token, linha)
  activate Gateway
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicoesVeiculos(linha)
  activate Model
  Model --> Service : listaVeiculosAtualizada(posicoes)
  deactivate Model
  Service --> Gateway : resposta(posicoes)
  deactivate Service
  Gateway --> View : retornarResposta(posicoes)
  deactivate Gateway
  View -> View : atualizarIconesVeiculosNoMapa(posicoes)
end

deactivate View
@enduml
