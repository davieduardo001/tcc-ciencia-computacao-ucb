@startuml UC21_BuscarParada
hide footbox
title Diagrama de Sequencia - Buscar Parada por Nome ou Endereco (US #21)

actor "Passageiro" as Passageiro

participant ":TelaBusca" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoParadas" as Service <<servico paradas>>
participant ":ModeloParada" as Model <<modelo>>

Passageiro -> View : digitarTermoBusca(termo)
activate View

View -> Gateway : requisicao(token, termo)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : consultarParadaPorNome(termo)
  activate Model

  alt parada encontrada por nome
    Model --> Service : resultadosParadas(lista)
    deactivate Model
    Service --> Gateway : resposta(resultadosParadas)
    deactivate Service
    Gateway --> View : retornarResposta(resultadosParadas)
    View -> View : exibirListaResultados(lista)
    View -> View : destacarParadasNoMapa(lista)

  else busca por endereco ou ponto de referencia
    Model --> Service : semResultadoPorNome()
    deactivate Model

    Service -> Model : geocodificarEndereco(termo)
    activate Model
    Model --> Service : coordenadasEndereco(lat, lng)
    deactivate Model

    Service -> Model : buscarParadasEmRaio(lat, lng, raio500m)
    activate Model

    alt paradas encontradas no raio
      Model --> Service : paradasProximas(lista)
      deactivate Model
      Service --> Gateway : resposta(paradasProximas)
      deactivate Service
      Gateway --> View : retornarResposta(paradasProximas)
      View -> View : centralizarMapaNaRegiao(lat, lng)
      View -> View : exibirParadasEmRaio(lista)

    else nenhum resultado
      Model --> Service : semParadasNaRegiao()
      deactivate Model
      Service --> Gateway : respostaErro(semResultados)
      deactivate Service
      Gateway --> View : retornarResposta(semResultados)
      View -> View : exibirMensagemSemResultados()
    end
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : consultarParadaPorNome(termo)
  activate Model
  Model --> Service : resultadosParadas(lista)
  deactivate Model
  Service --> Gateway : resposta(resultadosParadas)
  deactivate Service
  Gateway --> View : retornarResposta(resultadosParadas)
  View -> View : exibirListaResultados(lista)
  View -> View : destacarParadasNoMapa(lista)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway
deactivate View
@enduml
