@startuml UC19_TempoEstimadoChegada
hide footbox
title Diagrama de Sequencia - Ver Tempo Estimado de Chegada do Onibus (US #19)

actor "Passageiro" as Passageiro

participant ":TelaETA" as View <<interface usuario>>
participant ":GatewayAPI" as Gateway <<servico gateway>>
participant ":ControladorAutenticacao" as Auth <<servico autenticacao>>
participant ":ModeloSessao" as Sessao <<modelo>>
participant ":ServicoETA" as Service <<servico eta>>
participant ":ModeloVeiculo" as Model <<modelo>>

Passageiro -> View : selecionarLinhaEParada(linha, parada)
activate View

View -> Gateway : requisicao(token, linha, parada)
activate Gateway

Gateway -> Gateway : verificarAssinaturaToken(token)

alt token valido
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service

  Service -> Model : obterPosicaoVeiculoMaisProximo(linha, parada)
  activate Model

  alt posicao GPS disponivel
    Model --> Service : posicaoVeiculo(lat, lng, velocidade)
    deactivate Model
    Service -> Model : calcularETA(posicaoVeiculo, parada)
    activate Model
    Model --> Service : etaEmMinutos(valor)
    deactivate Model
    Service --> Gateway : resposta(etaEmMinutos)
    deactivate Service
    Gateway --> View : retornarResposta(etaEmMinutos)
    View -> View : exibirTempoEstimadoChegada(minutos)

  else dado GPS indisponivel
    Model --> Service : gpsIndisponivel()
    deactivate Model
    Service -> Model : obterHorarioTeorico(linha, parada)
    activate Model
    Model --> Service : horarioTeorico(horario)
    deactivate Model
    Service --> Gateway : resposta(horarioTeorico)
    deactivate Service
    Gateway --> View : retornarResposta(horarioTeorico)
    View -> View : exibirHorarioTeoricoComAviso()
  end

else token expirado
  Gateway -> Auth : renovarSessao(refreshToken)
  activate Auth
  Auth -> Sessao : verificarTokenRenovacao(refreshToken)
  activate Sessao
  Sessao --> Auth : tokenValido
  deactivate Sessao
  Auth -> Sessao : emitirNovoTokenAcesso(usuarioId)
  activate Sessao
  Sessao --> Auth : novoToken
  deactivate Sessao
  Auth --> Gateway : sessaoRenovada(novoToken)
  deactivate Auth

  Gateway -> Service : encaminharRequisicaoOriginal(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicaoVeiculoMaisProximo(linha, parada)
  activate Model
  Model --> Service : posicaoVeiculo(lat, lng, velocidade)
  deactivate Model
  Service -> Model : calcularETA(posicaoVeiculo, parada)
  activate Model
  Model --> Service : etaEmMinutos(valor)
  deactivate Model
  Service --> Gateway : resposta(etaEmMinutos)
  deactivate Service
  Gateway --> View : retornarResposta(etaEmMinutos)
  View -> View : exibirTempoEstimadoChegada(minutos)

else token invalido ou refresh revogado
  Gateway --> View : notificarNaoAutorizado(401)
  View -> View : redirecionarParaLogin("Sua sessao expirou. Faca login novamente.")
end

deactivate Gateway

loop atualizacao continua do ETA
  View -> Gateway : atualizarETA(token, linha, parada)
  activate Gateway
  Gateway -> Service : encaminharRequisicao(req, identidadeUsuario)
  activate Service
  Service -> Model : obterPosicaoVeiculoMaisProximo(linha, parada)
  activate Model
  Model --> Service : posicaoAtualizada(lat, lng)
  deactivate Model
  Service -> Model : calcularETA(posicaoVeiculo, parada)
  activate Model
  Model --> Service : novoETA(minutos)
  deactivate Model
  Service --> Gateway : resposta(novoETA)
  deactivate Service
  Gateway --> View : retornarResposta(novoETA)
  deactivate Gateway
  View -> View : atualizarTempoEstimadoExibido(minutos)
end

deactivate View
@enduml
